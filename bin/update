#!/usr/bin/env zsh


[ "$1" = "-a" ] && echo_separate "makepkg vscode insiders" \
&& cd ~/.cache/yay/visual-studio-code-insiders-bin \
&& makepkg -si --noconfirm

echo_separate "sudo pacman -Syu"
sudo pacman -Syu

echo_separate "yay -Syu"
yay -Syyu

echo_separate "tldr -u"
tldr -u

echo_separate "zinit"
zinit update

